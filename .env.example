# Copy to .env and fill in. .env is git-ignored.
DB_NAME=kvarteri
DB_USER=kvarteri
DB_PASSWORD=change-me
# Creates the first admin on startup (password min 10 chars). Remove after first login if you like.
KVARTERI_ADMIN_EMAIL=admin@example.com
KVARTERI_ADMIN_PASSWORD=change-me-please
# Frontend origins allowed by CORS (comma separated)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
